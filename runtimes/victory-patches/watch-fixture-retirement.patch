+    /// Reusing an address must not inherit the retired fixture's journal keys.
+    /// A separate live allocation still has to report its earlier write.
+    #[test]
+    fn retired_test_ranges_do_not_pollute_reused_addresses() {
+        let live = WatchedTestAllocation::new(PAGE);
+        let retired = WatchedTestAllocation::new(PAGE);
+        let (live_at, old_at) = (live.address(), retired.address());
+        // SAFETY: each byte belongs to a separate live watched allocation.
+        unsafe {
+            (live_at as *mut u8).write(1);
+            (old_at as *mut u8).write(2);
+        }
+        let (live_stamp, live_pages) = writes(live_at, live_at + PAGE, false).unwrap();
+        assert_eq!(live_pages, [(live_at / PAGE, live_stamp)]);
+        let (old_stamp, old_pages) = writes(old_at, old_at + PAGE, false).unwrap();
+        assert_eq!(old_pages, [(old_at / PAGE, old_stamp)]);
+        // Use the same retirement as Drop, but keep the address reserved while
+        // replacing its contents so parallel allocators cannot steal it.
+        retired.retire_writes();
+        use windows_sys::Win32::System::Memory::{
+            MEM_COMMIT, MEM_DECOMMIT, ResetWriteWatch, VirtualAlloc, VirtualFree,
+        };
+        // SAFETY: this fixture owns the entire range and retains its reservation.
+        let freed = unsafe { VirtualFree(old_at as *mut _, PAGE, MEM_DECOMMIT) };
+        assert_ne!(freed, 0);
+        // SAFETY: commit exactly the reserved range; it has no remaining users.
+        let reused = unsafe { VirtualAlloc(old_at as *const _, PAGE, MEM_COMMIT, PAGE_READWRITE) };
+        assert_eq!(reused as usize, old_at, "the control must reuse the exact address");
+        // SAFETY: a live watched allocation; establish the new kernel epoch.
+        assert_eq!(unsafe { ResetWriteWatch(reused, PAGE) }, 0);
+        let (now, before) = writes(old_at, old_at + PAGE, false).unwrap();
+        assert!(now > old_stamp, "retirement must not reset the asking");
+        assert!(before.is_empty(), "a fresh allocation inherited a retired journal entry");
+        let (later, still_live) = writes(live_at, live_at + PAGE, false).unwrap();
+        assert!(later > now);
+        assert_eq!(still_live, live_pages, "retirement must preserve unrelated live writes");
+        eprintln!("watch fixture retirement: same-address reuse is clean; unrelated live write and monotonic asking retained");
     }
 
