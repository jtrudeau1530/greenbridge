+/// A test's private watched range. The journal intentionally outlives kernel
+/// write-watch resets, so a fixture must retire its entries before freeing an
+/// address that another test can reuse. Other ranges and the asking stay intact.
+#[cfg(test)]
+pub(crate) struct WatchedTestAllocation {
+    address: usize,
+    size: usize,
+}
+
+#[cfg(test)]
+impl WatchedTestAllocation {
+    pub(crate) fn new(size: usize) -> Self {
+        use windows_sys::Win32::System::Memory::{
+            MEM_COMMIT, MEM_RESERVE, PAGE_READWRITE, VirtualAlloc,
+        };
+        assert!(size > 0 && size.is_multiple_of(PAGE));
+        // SAFETY: reserve and commit our own private write-watched range.
+        let allocated = unsafe {
+            VirtualAlloc(std::ptr::null(), size, MEM_RESERVE | MEM_COMMIT | 0x20_0000, PAGE_READWRITE)
+        } as usize;
+        assert_ne!(allocated, 0, "watched test allocation");
+        Self { address: allocated, size }
+    }
+
+    pub(crate) fn address(&self) -> usize {
+        self.address
+    }
+
+    fn retire_writes(&self) {
+        let (first, last) = (self.address / PAGE, (self.address + self.size) / PAGE);
+        let mut journal = JOURNAL.lock().unwrap_or_else(|e| e.into_inner());
+        journal.written.retain(|page, _| !(first..last).contains(page));
+    }
+}
+
+#[cfg(test)]
+impl Drop for WatchedTestAllocation {
+    fn drop(&mut self) {
+        self.retire_writes();
+        // SAFETY: this fixture still owns the full allocation. Its heap users
+        // must be dropped first; release only after removing its journal keys.
+        let freed = unsafe {
+            windows_sys::Win32::System::Memory::VirtualFree(
+                self.address as *mut _, 0, windows_sys::Win32::System::Memory::MEM_RELEASE,
+            )
+        };
+        if !std::thread::panicking() {
+            assert_ne!(freed, 0, "release watched test allocation");
+        }
+    }
+}
+
