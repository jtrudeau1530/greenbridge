+#define RS "DescriptorTable(SRV(t0, numDescriptors = 4)), UAV(u0)"
+ByteAddressBuffer bounded : register(t0);
+ByteAddressBuffer missing : register(t1);
+ByteAddressBuffer short_view : register(t2);
+ByteAddressBuffer empty_view : register(t3);
+RWByteAddressBuffer seen : register(u0);
+[RootSignature(RS)]
+[numthreads(8, 1, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+    uint at = id.x * 4;
+    seen.Store(at, bounded.Load(at));
+    seen.Store(32 + at, missing.Load(at));
+    seen.Store(64 + at, short_view.Load(at));
+    seen.Store(96 + at, empty_view.Load(at));
