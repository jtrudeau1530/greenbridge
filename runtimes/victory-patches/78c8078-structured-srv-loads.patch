+#[test]
+#[ignore = "requires a physical SM 6.6 GPU and native DXIL validator"]
+fn scalar_structured_boundaries_counts_and_raw_control_read_back() {
+    use windows::Win32::Graphics::Dxgi::{
+        CreateDXGIFactory2, DXGI_ADAPTER_FLAG_SOFTWARE, DXGI_CREATE_FACTORY_FLAGS, IDXGIAdapter1,
+        IDXGIFactory4,
+    };
+    let _one = super::valu_tests::ONE_AT_A_TIME
+        .lock()
+        .unwrap_or_else(|e| e.into_inner());
+    assert_ne!(
+        std::env::var("VICTORY_WARP").as_deref(),
+        Ok("1"),
+        "physical hardware is required"
+    );
+    let host = Host::new(false).expect("physical SM 6.6 device required");
+    // SAFETY: query the adapter of this existing device, using valid DXGI interfaces.
+    let desc = unsafe {
+        let factory: IDXGIFactory4 =
+            CreateDXGIFactory2(DXGI_CREATE_FACTORY_FLAGS(0)).expect("DXGI factory");
+        let adapter: IDXGIAdapter1 = factory
+            .EnumAdapterByLuid(host.device.GetAdapterLuid())
+            .expect("device adapter");
+        adapter.GetDesc1().expect("adapter description")
+    };
+    assert_eq!(
+        desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE.0 as u32,
+        0,
+        "software adapter is not this gate"
+    );
+    let end = desc
+        .Description
+        .iter()
+        .position(|&c| c == 0)
+        .unwrap_or(desc.Description.len());
+    eprintln!(
+        "physical adapter: {} vendor={:#06x} device={:#06x}",
+        String::from_utf16_lossy(&desc.Description[..end]),
+        desc.VendorId,
+        desc.DeviceId
+    );
+    let mut validator = validator::Validator::load(validator::Validator::default_path().as_deref())
+        .expect("DXIL validator required");
+    let data: Vec<u32> = (0..60).map(|i| 0xA000_0000 | (i * 0x101 + 7)).collect();
+    for (structured, count_used, width) in [
+        (true, false, 2),
+        (true, false, 4),
+        (true, true, 4),
+        (false, false, 4),
+    ] {
+        let shader = build(structured, count_used, width).expect("lower numerical fixture");
+        validator
+            .validate(&mut shader.dxil.clone())
+            .expect("validate numerical fixture");
+        let (root, pso) = host
+            .compute_pipeline(&shader)
+            .expect("create numerical pipeline");
+        let offsets: &[u32] = if count_used {
+            // Neither input names the last record: the scalar count arithmetic
+            // must replace s0 with (3 - 1) * 80 before the load.
+            &[0, 76]
+        } else if width == 2 {
+            &[76, 156]
+        } else {
+            &[0, 76, 156]
+        };
+        let guards: &[u32] = if count_used { &[3, 4] } else { &[0] };
+        for &byte_offset in offsets {
+            for &guard in guards {
+                let mut ud = vec![0; shader.user_data_dwords().max(1) as usize];
+                for u in &shader.user_data {
+                    ud[u.index as usize] = match (u.root, u.slot, u.dword) {
+                        (RootType::Constants, 0, 0) => byte_offset,
+                        (RootType::Constants, 0, 1) => guard,
+                        (RootType::Table, 1, _) => 0,
+                        other => panic!("unexpected user data {other:?}"),
+                    };
+                }
+                let out = host
+                    .dispatch(
+                        &root,
+                        &pso,
+                        &Dispatch {
+                            roots: vec![(0, Root::Constants(ud))],
+                            views: &[
+                                View::RawUav(OUTPUT_WORDS),
+                                View::Buffer {
+                                    data: &data,
+                                    stride: if structured {
+                                        Stride::Structured(STRIDE)
+                                    } else {
+                                        Stride::Raw
+                                    },
+                                },
+                            ],
+                            samplers: &[],
+                            groups: [1; 3],
+                        },
+                    )
+                    .expect("dispatch and read back");
+                let mut want: Vec<_> = (0..OUTPUT_WORDS).map(sentinel).collect();
+                if count_used {
+                    want[1] = 3;
+                }
+                if !count_used || guard == 3 {
+                    let read_byte = if count_used {
+                        (3 - 1) * STRIDE
+                    } else {
+                        byte_offset
+                    };
+                    for k in 0..width {
+                        want[(2 + k) as usize] = data[(read_byte / 4 + k) as usize];
+                    }
+                }
+                assert_eq!(
+                    out[0], want,
+                    "structured={structured} count={count_used} width={width} byte={byte_offset} guard={guard}"
+                );
+                eprintln!(
+                    "exact readback: structured={structured} count={count_used} width={width} byte={byte_offset} guard={guard} data={:08x?}",
+                    out[0]
+                );
+            }
+        }
+    }
+}
