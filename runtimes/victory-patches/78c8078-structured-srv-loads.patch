+//! Synthetic scalar buffer readbacks: declaration proof, record boundaries,
+//! and descriptor counts. Uses only generated instructions and buffer data.
+
+use super::container::{Binding, Psv, psv};
+use super::host::{Dispatch, Host, Root, Stride, View};
+use super::{HostShader, PsvBindings, lower, validator};
+use crate::native::{
+    ComputeIo, HwStage, NativeProgram, ResourceType, RootParam, RootType, StageIo, UsedResource,
+};
+use crate::{ShaderError, io, ir, resource, structure};
+
+const STRIDE: u32 = 80;
+const OUTPUT_WORDS: u32 = 8;
+const S_ENDPGM: u32 = 0xBF81_0000;
+
+fn sentinel(index: u32) -> u32 {
+    0xC0DE_0000 | index
+}
+
+fn store(words: &mut Vec<u32>, index: u32) {
+    // buffer_store_dword v0, off, s[8:11], 0 offset:index*4
+    words.extend([0xE070_0000 | (index * 4), 0x8002_0000]);
+}
+
+/// Public #984's scalar/table instruction layout, restricted to scalar reads;
+/// #995's PSV proof with an 80-byte stride. s0 is a byte offset, s1 a count
+/// guard, and s4 the table address. The UAV is slot 0 and the SRV is slot 1.
+fn build(structured: bool, count_used: bool, width: u32) -> Result<HostShader, ShaderError> {
+    assert!(matches!(width, 2 | 4));
+    let mut words = vec![
+        0xBE85_0380, // s_mov_b32 s5, 0
+        0xF408_0202,
+        0xFA00_0000, // s_load_dwordx4 s[8:11], s[4:5], 0
+        0xF408_0302,
+        0xFA00_0020, // s_load_dwordx4 s[12:15], s[4:5], 32
+    ];
+    for index in 0..OUTPUT_WORDS {
+        words.extend([0x7E00_02FF, sentinel(index)]); // v_mov_b32 v0, literal
+        store(&mut words, index);
+    }
+    let branch = if count_used {
+        words.push(0x7E00_020E); // v_mov_b32 v0, s14 (NUM_RECORDS)
+        store(&mut words, 1);
+        words.push(0xBF07_010E); // s_cmp_lg_u32 s14, s1
+        let at = words.len();
+        words.push(0); // s_cbranch_scc1 -> end, patched below
+        words.extend([
+            0x8080_810E, // s_sub_u32 s0, s14, 1
+            0x9300_FF00,
+            STRIDE, // s_mul_i32 s0, s0, 80: last record's byte offset
+        ]);
+        Some(at)
+    } else {
+        None
+    };
+    let opcode = if width == 2 { 0x09 } else { 0x0A };
+    words.extend([
+        0x3D << 26 | opcode << 18 | 16 << 6 | (12 >> 1),
+        0, // s_buffer_load_dwordx{2,4} s[16:...], s[12:15], s0
+    ]);
+    for k in 0..width {
+        words.push(0x7E00_0200 | (16 + k)); // v_mov_b32 v0, s[16+k]
+        store(&mut words, 2 + k);
+    }
+    if let Some(at) = branch {
+        let delta = u16::try_from(words.len() - at - 1).expect("short branch");
+        words[at] = 0xBF85_0000 | u32::from(delta);
+    }
+    words.push(S_ENDPGM);
+
+    let native = NativeProgram {
+        stage: HwStage::Cs,
+        wave64: false,
+        vgprs: 4,
+        layout: vec![
+            RootParam {
+                root: RootType::Constants,
+                table_offset_dwords: 0,
+                sgprs: 2,
+                base_register: 0,
+                user_data: 0,
+                slot: 0,
+            },
+            RootParam {
+                root: RootType::Table,
+                table_offset_dwords: 0,
+                sgprs: 1,
+                base_register: 0,
+                user_data: 4,
+                slot: 1,
+            },
+        ],
+        used: vec![
+            UsedResource {
+                kind: ResourceType::Uav,
+                root: RootType::Table,
+                table_offset_dwords: 0,
+                lower_bound: 0,
+                stride: 0,
+                dwords: 4,
+                user_data: 4,
+                slot: 1,
+            },
+            UsedResource {
+                kind: ResourceType::Srv,
+                root: RootType::Table,
+                table_offset_dwords: 8,
+                lower_bound: 7,
+                stride: STRIDE, // Deliberately identical for raw and structured cases.
+                dwords: 4,
+                user_data: 4,
+                slot: 1,
+            },
+        ],
+        io: StageIo::Cs(ComputeIo {
+            rsrc2: 5 << 1,
+            threads: [1; 3],
+        }),
+        code: words.iter().flat_map(|w| w.to_le_bytes()).collect(),
+    };
+    let p = ir::build(&native.code, native.wave64, native.vgprs).expect("decode synthetic program");
+    let names: Vec<_> = p
+        .blocks
+        .iter()
+        .flat_map(|b| b.insts.iter().map(|i| i.name()))
+        .collect();
+    let load = if width == 2 {
+        "s_buffer_load_dwordx2"
+    } else {
+        "s_buffer_load_dwordx4"
+    };
+    assert_eq!(names.iter().filter(|&&n| n == load).count(), 1);
+    assert_eq!(names.iter().filter(|&&n| n == "s_load_dwordx4").count(), 2);
+    assert_eq!(
+        names.iter().filter(|&&n| n == "buffer_store_dword").count(),
+        OUTPUT_WORDS as usize + width as usize + usize::from(count_used)
+    );
+    if count_used {
+        assert!(names.contains(&"s_cmp_lg_u32"));
+        assert!(names.contains(&"s_sub_u32"));
+        assert!(names.contains(&"s_mul_i32"));
+    }
+    let st = structure::structure(&p).expect("structure synthetic program");
+    let res =
+        resource::track(&p, &native.layout, native.stage, Some(&st)).expect("track resources");
+    let io = io::raise(&p, &native).expect("raise IO");
+    let declarations = psv(&Psv {
+        stage: 5,
+        flag: false,
+        inputs: &[],
+        outputs: &[],
+        prims: &[],
+        mesh: None,
+        bindings: &[
+            Binding {
+                kind: 7,
+                space: 0,
+                register: 0,
+                dxil_kind: 11,
+            },
+            Binding {
+                kind: if structured { 5 } else { 4 },
+                space: 3,
+                register: 7,
+                dxil_kind: if structured { 12 } else { 11 },
+            },
+        ],
+        threads: [1; 3],
+        wave_size: None,
+    });
+    let lowered = lower::lower(&lower::Parts {
+        native: &native,
