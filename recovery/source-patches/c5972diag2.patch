new file mode 100644
index 000000000..472092f07
--- /dev/null
+++ b/runtime/src/diag_targets.h
@@ -0,0 +1,124 @@
+#pragma once
+// LOCAL DIAGNOSTIC (claude-worker c5972diag, not upstream): logging only, no behaviour change. Abstract ids for the
+// resources render targets, clears, draws and PresentX planes name; draw-time viewport/scissor/topology state; counts
+// of the RS/IA setters reaching the PC list and of console list slots the proxy records but does not forward.
+// Detailed lines for the first kFrames PresentX calls; totals at power-of-two presents. Namespace-scope state only
+// (no function-local statics).
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+
+namespace leonida::diag {
+
+inline constexpr unsigned kFrames = 4;
+inline std::atomic<unsigned> g_present{0};
+inline bool on() { return g_present.load(std::memory_order_relaxed) < kFrames; }
+
+struct IdSlot {
+    std::uintptr_t key;
+    unsigned id;
+};
+inline constexpr unsigned kIdSlots = 1024;
+inline IdSlot g_ids[kIdSlots];
+inline unsigned g_next_id = 0;
+inline std::mutex g_id_mutex;
+
+// A small stable id for a resource key (0 = none); `fresh` is set when the key was seen for the first time.
+inline unsigned rid(std::uintptr_t key, bool* fresh = nullptr) {
+    if (fresh) *fresh = false;
+    if (!key) return 0;
+    std::lock_guard lock(g_id_mutex);
+    for (unsigned i = 0; i < g_next_id && i < kIdSlots; ++i)
+        if (g_ids[i].key == key) return g_ids[i].id;
+    if (g_next_id >= kIdSlots) return 9999;
+    g_ids[g_next_id] = {key, g_next_id + 1};
+    if (fresh) *fresh = true;
+    return ++g_next_id;
+}
+
+enum Counter : unsigned { viewports, viewports_zero, scissors, scissors_zero, topology, vertex_buffers, draws,
+                          draws_no_viewport, draws_no_scissor, clears, om_sets, kCounters };
+inline std::atomic<unsigned long long> g_counts[kCounters];
+inline const char* counter_name(unsigned c) {
+    switch (c) {
+    case viewports: return "RSSetViewports";
+    case viewports_zero: return "RSSetViewports(count 0)";
+    case scissors: return "RSSetScissorRects";
+    case scissors_zero: return "RSSetScissorRects(count 0)";
+    case topology: return "IASetPrimitiveTopology";
+    case vertex_buffers: return "IASetVertexBuffers";
+    case draws: return "Draw*";
+    case draws_no_viewport: return "Draw* with no viewport bound";
+    case draws_no_scissor: return "Draw* with no scissor bound";
+    case clears: return "ClearRenderTargetView";
+    case om_sets: return "OMSetRenderTargets";
+    default: return "?";
+    }
+}
+inline void count(Counter c) { g_counts[c].fetch_add(1, std::memory_order_relaxed); }
+
+inline constexpr unsigned kListSlots = 192;
+inline std::atomic<unsigned long long> g_unforwarded[kListSlots];
+
+// The shape of a 64-bit argument word: 0, a small integer (printed), or a pointer-sized value (not printed).
+inline void shape(char* out, std::size_t size, std::uint64_t v) {
+    if (v == 0) std::snprintf(out, size, "0");
+    else if (v < 0x10000) std::snprintf(out, size, "%llu", static_cast<unsigned long long>(v));
+    else if (v < 0x100000000ull) std::snprintf(out, size, "u32big");
+    else std::snprintf(out, size, "ptr");
+}
+
+inline void note_unforwarded(unsigned slot, std::uint64_t a1, std::uint64_t a2, std::uint64_t a3, std::uint64_t a4) {
+    if (slot >= kListSlots) return;
+    const unsigned long long n = g_unforwarded[slot].fetch_add(1, std::memory_order_relaxed);
+    if (n < 3 || on()) {
+        char s[4][24];
+        shape(s[0], sizeof s[0], a1); shape(s[1], sizeof s[1], a2); shape(s[2], sizeof s[2], a3); shape(s[3], sizeof s[3], a4);
+        std::fprintf(stderr, "[diag] list slot %u (not forwarded) call %llu args %s %s %s %s\n", slot, n + 1, s[0], s[1],
+                     s[2], s[3]);
+    }
+}
+
+inline void totals(unsigned present) {
+    std::fprintf(stderr, "[diag] totals at present %u:", present);
+    for (unsigned c = 0; c < kCounters; ++c)
+        std::fprintf(stderr, " %s=%llu", counter_name(c), g_counts[c].load(std::memory_order_relaxed));
+    std::fprintf(stderr, "\n[diag] unforwarded list slots at present %u:", present);
+    for (unsigned s = 0; s < kListSlots; ++s)
+        if (const auto n = g_unforwarded[s].load(std::memory_order_relaxed)) std::fprintf(stderr, " %u=%llu", s, n);
+    std::fprintf(stderr, "\n");
+}
+
+}  // namespace leonida::diag
+
+// ---- c5972diag2 additions (LOCAL DIAGNOSTIC): pipeline blend summaries, the scene target, readback hook ----
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+namespace leonida::diag {
+inline std::mutex g_pipe_mutex;
+inline std::unordered_map<std::uintptr_t, std::string> g_pipelines;  // graphics pipeline id -> blend/RT summary
+inline void note_pipeline(std::uintptr_t id, std::string summary) {
+    std::lock_guard lock(g_pipe_mutex);
+    g_pipelines[id] = std::move(summary);
+}
+inline std::string pipeline(std::uintptr_t id) {
+    std::lock_guard lock(g_pipe_mutex);
+    const auto it = g_pipelines.find(id);
+    return it == g_pipelines.end() ? std::string("unknown") : it->second;
+}
+inline std::mutex g_alive_mutex;
+inline std::unordered_set<std::uintptr_t> g_alive;  // layer Resource ids currently alive
+inline void alive(std::uintptr_t id, bool yes) {
+    std::lock_guard lock(g_alive_mutex);
+    if (yes) g_alive.insert(id); else g_alive.erase(id);
+}
+inline bool is_alive(std::uintptr_t id) {
+    std::lock_guard lock(g_alive_mutex);
+    return g_alive.count(id) != 0;
+}
+inline std::atomic<std::uintptr_t> g_scene{0};  // the render target of the last draw with a depth target bound
+inline bool (*g_read_hook)(std::uintptr_t key, unsigned present, const char* tag) = nullptr;
+inline bool sample_present(unsigned n) { return n == 60 || n == 120 || n == 240; }
+}  // namespace leonida::diag
