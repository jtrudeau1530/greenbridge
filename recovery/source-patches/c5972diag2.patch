+// LOCAL DIAGNOSTIC (c5972diag2): read a layer render target back after the GPU is idle and write <dir>/<tag>_<n>.ppm
+// plus a stats line. RGBA8 only. Called at sampled PresentX calls; the copy moves the image's layout as a
+// CopyTextureRegion would (a diagnostic perturbation), and the device wait serialises the frame.
+bool diag_read_target(std::uintptr_t key, unsigned present, const char* tag) {
+    if (!key || !leonida::diag::is_alive(key)) {
+        std::fprintf(stderr, "[diag] readback %s at present %u: no live resource\n", tag, present);
+        return false;
+    }
+    auto* resource = reinterpret_cast<ID3D12Resource*>(key);
+    Resource* r = Resource::from<Resource>(resource);
+    if (!r) return false;
+    const D3D12_RESOURCE_DESC d = r->GetDesc();
+    const unsigned id = leonida::diag::rid(key);
+    if (d.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D ||
+        (d.Format != DXGI_FORMAT_R8G8B8A8_UNORM && d.Format != DXGI_FORMAT_R8G8B8A8_UNORM_SRGB &&
+         d.Format != DXGI_FORMAT_B8G8R8A8_UNORM && d.Format != DXGI_FORMAT_R8G8B8A8_TYPELESS)) {
+        std::fprintf(stderr, "[diag] readback %s RES#%u at present %u: format %u not read\n", tag, id, present, unsigned(d.Format));
+        return false;
+    }
+    const UINT w = UINT(d.Width), h = d.Height, pitch = w * 4;
+    std::vector<std::uint8_t> px(std::size_t(pitch) * h);
+    r->diag_wait_idle();
+    const HRESULT hr = r->ReadFromSubresource(px.data(), pitch, pitch * h, 0, nullptr);
+    if (FAILED(hr)) {
+        std::fprintf(stderr, "[diag] readback %s RES#%u at present %u: ReadFromSubresource 0x%08lx\n", tag, id, present, long(hr));
+        return false;
+    }
+    const bool bgra = d.Format == DXGI_FORMAT_B8G8R8A8_UNORM;
+    unsigned long long nz = 0, sum[4] = {0, 0, 0, 0};
+    unsigned mn[4] = {255, 255, 255, 255}, mx[4] = {0, 0, 0, 0};
+    std::vector<std::uint8_t> rgb(std::size_t(w) * h * 3);
+    for (std::size_t i = 0, n = std::size_t(w) * h; i < n; ++i) {
+        const std::uint8_t* p = &px[i * 4];
+        const std::uint8_t c[4] = {bgra ? p[2] : p[0], p[1], bgra ? p[0] : p[2], p[3]};
+        if (c[0] || c[1] || c[2]) ++nz;
+        for (int k = 0; k < 4; ++k) { sum[k] += c[k]; mn[k] = c[k] < mn[k] ? c[k] : mn[k]; mx[k] = c[k] > mx[k] ? c[k] : mx[k]; }
+        rgb[i * 3] = c[0]; rgb[i * 3 + 1] = c[1]; rgb[i * 3 + 2] = c[2];
+    }
+    const double n = double(w) * h;
+    std::fprintf(stderr, "[diag] readback %s RES#%u %ux%u fmt %u at present %u: nonzero_rgb %llu of %.0f mean rgba %.3f %.3f %.3f %.3f "
+                 "min %u %u %u %u max %u %u %u %u\n", tag, id, w, h, unsigned(d.Format), present, nz, n, sum[0] / n, sum[1] / n,
+                 sum[2] / n, sum[3] / n, mn[0], mn[1], mn[2], mn[3], mx[0], mx[1], mx[2], mx[3]);
+    char dir[512] = {};
+    std::size_t length = 0;
+    if (getenv_s(&length, dir, sizeof dir, "LEONIDA_DIAG_DIR") == 0 && length > 1) {
+        std::error_code ec;
+        std::filesystem::create_directories(dir, ec);
+        char name[96];
+        std::snprintf(name, sizeof name, "%s_%04u_RES%u.ppm", tag, present, id);
+        const std::filesystem::path path = std::filesystem::path(dir) / name;
+        if (FILE* f = _wfopen(path.wstring().c_str(), L"wb")) {
+            std::fprintf(f, "P6\n%u %u\n255\n", w, h);
+            std::fwrite(rgb.data(), 1, rgb.size(), f);
+            std::fclose(f);
+        }
+    }
+    return true;
+}
