-def _bitmask_imm(value, width):
-    v = value & ((1 << width) - 1)
-    if v == 0 or v == (1 << width) - 1:
-        return None
-    for e in (2, 4, 8, 16, 32, width):
-        if width % e:
-            continue
-        pat = v & ((1 << e) - 1)
-        rep = 0
-        for i in range(width // e):
-            rep |= pat << (i * e)
-        if rep != v:
-            continue
-        ones = bin(pat).count("1")
-        if ones == 0 or ones == e:
-            continue
-        rot = -1
-        p = pat
-        for r in range(e):
-            if p == (1 << ones) - 1:
-                rot = r
-                break
-            p = ((p >> 1) | (p << (e - 1))) & ((1 << e) - 1)
-        if rot < 0:
-            continue
-        n = 1 if e == 64 else 0
-        imms = (((-e) << 1) | (ones - 1)) & 0x3F
-        immr = (-rot) & (e - 1)
-        return n, immr, imms
-    return None
