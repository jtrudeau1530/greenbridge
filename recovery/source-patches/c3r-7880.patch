-            "\texp pos0 v1, v1, v1, v1 done\n"
-            "\texp param0 v1, v1, v1, v1\n"
-            "\ts_endpgm\n")
-MS_NGG = ("\tv_mbcnt_lo_u32_b32 v0, -1, 0\n"
-          "\ts_sendmsg sendmsg(MSG_GS_ALLOC_REQ)\n"
-          "\texp prim v1, off, off, off done\n"
-          "\texp pos0 v1, v1, v1, v1 done\n"
-          "\texp param0 v1, v1, v1, v1\n"
-          "\ts_endpgm\n")
