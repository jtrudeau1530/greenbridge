-            "\tv_fma_f32 v2, v4, v5, v6\n"
-            "\texp pos0 v1, v1, v1, v1 done\n"
-            "\texp param0 v2, v4, v5, v6\n"
-            "\ts_endpgm\n")
-VS_PLAIN = ("\tv_cvt_f32_u32_e32 v1, v0\n"
-            "\texp pos0 v1, v1, v1, v1 done\n"
-            "\texp param0 v1, v1, v1, v1\n"
-            "\ts_endpgm\n")
-ES_FETCH = ("\ts_swappc_b64 s[4:5], s[4:5]\n"
