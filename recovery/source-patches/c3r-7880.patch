-            counts["ops"].update(used)
-            status, detail = run_one(lines, f"ps_dfx_{tag}{i:05d}", tmp, counts["events"])
-            _tally(counts, status, detail)
-            if status == "mismatch" and failure is None:
-                failure = (label, lines, detail)
-    return failure
