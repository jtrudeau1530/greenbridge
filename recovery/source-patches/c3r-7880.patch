-    check(prop_clear(&pv) == S_OK && pv.vt == VT_EMPTY, "PropVariantClear resets PROPVARIANT");
-
-    void* mem = CoTaskMemAlloc(32);
-    task_free(mem);
-    task_free(nullptr);
-    check(true, "CoTaskMemFree accepts valid and null pointers");
-
-    co_uninit();
-}
-
-}  // namespace
