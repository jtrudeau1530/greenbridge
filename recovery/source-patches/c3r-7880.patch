-          "StringFromGUID2 rejects invalid output buffer");
-    check(guid_str(g1, buf, 64) == 39 && buf[0] == L'{' && buf[37] == L'}',
-          "StringFromGUID2 formats 39-char braced GUID");
-
-    PROPVARIANT pv{};
-    PropVariantInit(&pv);
-    pv.vt = VT_LPWSTR;
-    pv.pwszVal = static_cast<wchar_t*>(CoTaskMemAlloc(8 * sizeof(wchar_t)));
