-// ---- AcpHalCreate ----
-
-HRESULT __stdcall AcpHalCreate(void** ppAcpHal) {
-    if (!ppAcpHal) return E_POINTER;
-    *ppAcpHal = new AcpHalImpl();
-    trace_call("AcpHalCreate", "");
-    return S_OK;
-}
