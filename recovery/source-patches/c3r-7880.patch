-        raise ModsError(f"unsafe ZIP member name {name!r}")
-    parts = PurePosixPath(name).parts
-    if not parts or parts[0] == "/" or ".." in parts or "." in parts:
-        raise ModsError(f"unsafe ZIP member name {name!r}")
-    for part in parts:
-        if safe_folder_name(part) != part:
-            raise ModsError(f"unsafe ZIP member name {name!r}")
