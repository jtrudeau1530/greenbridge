-def sweep_cases(ops=None):
-    """(op, kinds) for every encodable source-kind combination of every op."""
-    cases = []
-    for op in ops or OPS:
-        allowed = KINDS64 if FMT[op].width == 64 else KINDS
-        for a in allowed:
-            for b in allowed:
-                for c in allowed:
-                    if encodable([a, b, c]):
-                        cases.append((op, (a, b, c)))
-    return cases
