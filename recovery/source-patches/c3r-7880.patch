-def program(rng, n_ops, ops=None):
-    """A random program: seeds, n_ops family ops, the export. Returns (lines, the ops used)."""
-    ops = list(ops or OPS)
-    lines = seeds(rng)
-    used = []
-    for _ in range(n_ops):
-        op = rng.choice(ops)
-        lines.append(op_line(rng, op)[0])
-        used.append(op)
-    return lines, used
