-def translate_function(code, guest_va):
-    """Decode and translate one function's x86-64 bytes. Returns FunctionTranslator."""
-    good = []
-    for i in disasm(code, guest_va):
-        if i.unknown or i.error:
-            break
-        good.append(i)
-    tr = FunctionTranslator(good)
-    tr.translate()
-    return tr
