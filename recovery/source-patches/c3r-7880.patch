-// GFX10 T# word 1 bits 20..28: the FORMAT field.
-std::uint32_t tsharp_format(const void* descriptor) {
-    std::uint32_t words[8] = {};
-    std::memcpy(words, descriptor, sizeof(words));
-    return (words[1] >> 20) & 0x1ff;
-}
