diff --git a/runtime/test/fixtures/tiny_thread_hook.cpp b/runtime/test/fixtures/tiny_thread_hook.cpp
new file mode 100644
index 000000000..0187d3265
--- /dev/null
+++ b/runtime/test/fixtures/tiny_thread_hook.cpp
@@ -0,0 +1,16 @@
+// Tiny fixture DLL for loader_tls_index0_test (threads): calls a function of the test EXE from its
+// DllMain(DLL_THREAD_ATTACH). Loaded before the runtime's TLS helper, so on a new thread this runs before the helper's
+// DLL_THREAD_ATTACH, the window in which only the OS has set up the thread's TLS. Ordinary test code, no game data.
+#include <windows.h>
+
+namespace {
+using Hook = void(__cdecl*)();
+Hook volatile g_hook = nullptr;
+}  // namespace
+
+extern "C" __declspec(dllexport) void __cdecl tiny_thread_hook_set(Hook hook) { g_hook = hook; }
+
+BOOL WINAPI DllMain(HINSTANCE, DWORD reason, LPVOID) {
+    if (reason == DLL_THREAD_ATTACH && g_hook) g_hook();
+    return TRUE;
+}
diff --git a/runtime/test/fixtures/tiny_tls_clones.cpp b/runtime/test/fixtures/tiny_tls_clones.cpp
new file mode 100644
index 000000000..c3b957c4d
--- /dev/null
+++ b/runtime/test/fixtures/tiny_tls_clones.cpp
@@ -0,0 +1,13 @@
+// Tiny fixture EXE for check_tls_clone_cleanup.cmake. It is ordinary test code, not game content.
+//
+// It imports two DLLs with static TLS, tiny_tls.dll and tiny_tls_cb_only.dll, and has TLS of its own. Mapped by gta6rt
+// the EXE takes module TLS index 0, one DLL takes the primary helper's index and the other needs a helper clone
+// (leonida_tls_host_<pid>_1.dll in %TEMP%), whose file gta6rt has to delete when it exits.
+extern "C" __declspec(dllimport) int __cdecl tiny_tls_get();
+extern "C" __declspec(dllimport) int __cdecl tiny_tls_cb_attach_count();
+
+namespace {
+thread_local int t_value = 3;
+}
+
+int main() { return tiny_tls_get() == 7 && tiny_tls_cb_attach_count() >= 0 && t_value == 3 ? 0 : 1; }
diff --git a/runtime/test/fixtures/tiny_tls_ga.cpp b/runtime/test/fixtures/tiny_tls_ga.cpp
new file mode 100644
index 000000000..a44d0e97d
--- /dev/null
+++ b/runtime/test/fixtures/tiny_tls_ga.cpp
@@ -0,0 +1,35 @@
+// Tiny fixture EXE for module TLS index 0. It is ordinary test code, not game content.
+//
+// Built /GA (CMakeLists.txt), the EXE-only option that lets the compiler assume the image is the process executable
+// and so has module TLS index 0: every thread_local access below reads TEB->ThreadLocalStoragePointer[0] directly
+// (mov rax, gs:[58h]; mov rax, [rax]) and never loads _tls_index. Mapped with any other index, the getter reads
+// whatever block sits in slot 0. loader_tls_index0_test calls the exports on threads of its own; under
+// `gta6rt --run` (run_tiny_tls_ga) main() checks the value on the game thread and on a second thread and returns 0
+// only when both read the template value 42.
+#include <cstdio>
+#include <thread>
+
+extern "C" unsigned long _tls_index;
+
+namespace {
+thread_local int t_value = 42;
+}
+
+extern "C" __declspec(dllexport) __declspec(noinline) int __cdecl tiny_ga_get() { return t_value; }
+extern "C" __declspec(dllexport) __declspec(noinline) void __cdecl tiny_ga_set(int value) { t_value = value; }
+// Where this thread's t_value is, so the test can find its offset inside the slot-0 block.
+extern "C" __declspec(dllexport) __declspec(noinline) int* __cdecl tiny_ga_address() { return &t_value; }
+extern "C" __declspec(dllexport) unsigned long __cdecl tiny_ga_tls_index() { return _tls_index; }
+extern "C" __declspec(dllexport) unsigned long* __cdecl tiny_ga_tls_index_address() { return &_tls_index; }
+
+int main() {
+    const int on_main = tiny_ga_get();
+    tiny_ga_set(7);
+    int on_thread = -1;
+    std::thread worker([&] { on_thread = tiny_ga_get(); });
+    worker.join();
+    const bool ok = on_main == 42 && on_thread == 42 && tiny_ga_get() == 7;
+    std::printf("tiny_tls_ga: tls_index=%lu main=%d thread=%d %s\n", _tls_index, on_main, on_thread,
+                ok ? "OK" : "FAILED");
+    return ok ? 0 : 1;
+}
