+    ABOVE: "Good",
+    BELOW: "Weak",
+    UNKNOWN: "Unknown",
+}
+BOOT_NOTE = ("Leonida compatibility and FPS: unknown",
+             "The game doesn't boot yet.")
+
+# ----------------------------------------------------------------------------
