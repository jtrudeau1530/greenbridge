-            _, reg, osz = op[0], op[1], op[2]
-            hi8 = len(op) > 3 and op[3]
-            g = GMAP[reg]
-            if osz == 8:
-                if g != src:
-                    a.mov(g, src)
-            elif osz == 4:
-                a.mov(g, src, sf=0)
-            elif osz == 2:
-                a.bfi(g, src, 0, 16)
