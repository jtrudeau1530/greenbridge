+    const size_t wanted_len = std::strlen(wanted) + 1;
+    for (uint32_t i = 0; i < ed->NumberOfNames; ++i) {
+        uint32_t name_rva, func_rva;
+        uint16_t ord;
+        std::memcpy(&name_rva, file.data() + names + 4 * i, 4);
