+IDStorageStatusArrayX* make_status(Env& env, UINT32 capacity) {
+    void* s = nullptr;
+    check_hr(env.factory->CreateStatusArray(capacity, "test status", kStatusId, &s), S_OK, "CreateStatusArray");
+    return static_cast<IDStorageStatusArrayX*>(s);
+}
