-def encodable(kinds):
-    """GFX10 VOP3: at most one literal, at most two constant-bus reads (SGPRs and the literal)."""
-    return sum(k == "lit" for k in kinds) <= 1 and sum(k in ("sgpr", "lit") for k in kinds) <= 2
