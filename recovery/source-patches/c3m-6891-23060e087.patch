-def _count(events, op, fmt, rule, bits):
-    if events is None:
-        return
-    ev = events.setdefault(op, Counter())
-    ev[RULES[rule]] += 1
-    for b in bits:
-        a = b & fmt.mag
-        if a > fmt.inf:
-            ev["NaN in"] += 1
-        elif a == fmt.inf:
-            ev["inf in"] += 1
-        elif 0 < a < fmt.min_norm:
-            ev["denormal in"] += 1
