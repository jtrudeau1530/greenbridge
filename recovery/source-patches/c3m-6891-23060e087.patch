-    f = FMT[{16: "v_div_fixup_f16", 32: "v_div_fixup_f32", 64: "v_div_fixup_f64"}[width]]
-    m = rng.randrange(1, f.min_norm) if e == 0 else rng.getrandbits(f.mbits)
-    return (sign << (width - 1)) | (e << f.mbits) | m
