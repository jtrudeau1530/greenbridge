-    CHECK(SUCCEEDED(al->Reset()) && SUCCEEDED(list->Reset(al.p, nullptr)));
-    CHECK(rt::d3d12::bound_descriptor_heap_bases(list.p, got_cbv, got_smp));
-    CHECK(got_cbv == 0 && got_smp == 0);
