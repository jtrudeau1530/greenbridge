+
+bool page_holds(const void* page, uint32_t tag) {
+    for (size_t i = 0; i < kPage64k / sizeof(uint32_t); i += 1024) {
+        if (read_u32(page, i * sizeof(uint32_t)) != tag + static_cast<uint32_t>(i)) return false;
+    }
+    return true;
+}
